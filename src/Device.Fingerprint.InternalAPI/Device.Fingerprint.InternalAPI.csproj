<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Fanex.Data" Version="4.3.4" />
		<PackageReference Include="Fanex.Data.MySql" Version="4.3.4" />
		<PackageReference Include="Fanex.Data.Repository" Version="4.3.4" />
		<PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.0.8" />
		<PackageReference Include="StackExchange.Redis.Extensions.Core" Version="10.2.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
		
		<PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.0.0" />
		<PackageReference Include="Fanex.Logging.Sentry" Version="1.0.6" />
		
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="7.0.13" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Device.Fingerprint.Core\Device.Fingerprint.Core.csproj" />
		<ProjectReference Include="..\Device.Fingerprint.Redis\Device.Fingerprint.Redis.csproj" />
		<ProjectReference Include="..\Device.Fingerprint\Device.Fingerprint.csproj" />
